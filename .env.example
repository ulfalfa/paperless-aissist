OPENAI_BASE_URL=http://localhost:11434
OPENAI_MODEL=gemma4:latest
# OPENAI_API_KEY=sk-...
# PROMPT_FILE=prompt.md

PAPERLESS_BASE_URL=https://your-paperless-instance
PAPERLESS_API_TOKEN=your-token-here

# MCP server Bearer token — required to enable the /mcp endpoint
# MCP_API_TOKEN=your-mcp-secret-here

# Signed file download URLs (used by download_document and document_preview MCP tools)
# FILE_URL_BASE_URL=https://your-public-hostname  # base URL for /files/{token} links
# FILE_URL_SECRET=<64-char hex>                   # HMAC secret; auto-generated if omitted

# PORT=8080
# SCAN_TAG=ai-scan
# SCAN_INTERVAL=0
# AI_TAG=ai-gen
# STRICT_METADATA=false

# RAG Chat
# EMBED_MODEL=bge-m3:latest
